# Copy values into the server process environment; never commit real secrets.
# Generate a unique value, for example: openssl rand -hex 32
# The server disables admin/key-management routes until this is >=32 characters and not a placeholder.
# Primary admin login: Google Identity Services Web OAuth client ID + exact email allowlist.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_OAUTH_CLIENT_ID
VIBES_ADMIN_EMAILS=admin@example.com

# Emergency-only server credential. Keep this secret server-side; never put it in Vyron X or browser code.
VIBES_GATEWAY_KEY=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
# Optional old key during a staged rotation; remove it after all callers have moved to the new key.
VIBES_GATEWAY_KEY_PREVIOUS=
VIBES_REGISTRY_FILE=data/vibes-apps.json
PORT=8080
HOST=0.0.0.0

# Comma-separated IPs of reverse proxies in front of this server (for example 10.0.0.5).
# Only when the direct peer is listed here is X-Forwarded-For used to pick the rate-limit bucket.
# Comma-separated exact proxy IPs or CIDR ranges. The server ignores X-Forwarded-For unless the
# direct peer matches one of these. Do not put client networks or 0.0.0.0/0 here.
VIBES_TRUSTED_PROXIES=
# Enable only when the public origin is guaranteed to be behind Cloudflare (e.g. Render ingress).
# Cloudflare documents CF-Connecting-IP as the visitor IP supplied from its edge.
VIBES_TRUST_CF_CONNECTING_IP=false

# Google Sign-In browser OAuth Web client ID is configured once above.

# Legacy JSON paths used as first-start import sources and as a no-database fallback.
# With VIBES_DATABASE_URL configured, the core registries and platform records are stored in SQL.
# Remaining file-backed services still need durable storage and backups.
VIBES_API_KEYS_FILE=data/vibes-api-keys.json
VIBES_CURRICULUM_STORE_FILE=data/vibes-curriculum.json
# Optional registry persistence (if omitted, defaults to data/vibes-apps.json).
VIBES_REGISTRY_FILE=data/vibes-apps.json


# Optional shared OpenAI-compatible inference proxy. Keep provider credentials server-only.
# The placeholder below is treated as unconfigured until you replace it with a real server-side key.
VIBES_UPSTREAM_BASE_URL=https://api.openai.com/v1
VIBES_UPSTREAM_API_KEY=replace-with-your-provider-key
VIBES_UPSTREAM_MODEL=

# Quantum Voice — Realtime speech and streaming transcription. Keep credentials server-side.
# File transcription remains available for completed recordings using gpt-transcribe.
VIBES_STT_BASE_URL=https://api.openai.com/v1
VIBES_STT_API_KEY=
VIBES_STT_MODEL=gpt-transcribe
# Realtime connections are server-proxied; the mobile app never receives this API key.
VIBES_REALTIME_API_KEY=
VIBES_REALTIME_BASE_URL=wss://api.openai.com/v1/realtime
VIBES_STT_REALTIME_URL=wss://api.openai.com/v1/realtime
VIBES_TTS_REALTIME_URL=wss://api.openai.com/v1/realtime
VIBES_REALTIME_STT_MODEL=gpt-live-transcribe
VIBES_REALTIME_TTS_MODEL=gpt-realtime-2.1-mini
# Budget reservation for one live transcription WebSocket session (settled at the reserved estimate).
VIBES_REALTIME_STT_SESSION_RESERVE_USD=0.02
VIBES_TTS_DEFAULT_VOICE=marin
VIBES_TTS_VOICES=alloy,ash,ballad,coral,echo,sage,shimmer,verse,marin,cedar
# Optional compatibility key alias for existing deployments; preferred is VIBES_REALTIME_API_KEY.
VIBES_TTS_API_KEY=
# Optional comma-separated model allowlist. Configure one or more current model IDs here or in VIBES_UPSTREAM_MODEL.
VIBES_ALLOWED_MODELS=
# Set actual model IDs only after validating the selected provider's current documentation.
# Cloud provider prices are configuration, not guesses. Leave empty to make that cloud adapter ineligible for budgeted council use.
VIBES_UPSTREAM_INPUT_COST_PER_1K_USD=
VIBES_UPSTREAM_OUTPUT_COST_PER_1K_USD=
VIBES_AI_PROVIDERS_FILE=config/ai-providers.json
# Copy config/ai-providers.example.json to this private file, set current model IDs, API-key env vars,
# and current per-1K token prices. Cloud providers are skipped until both prices are configured.
VIBES_OLLAMA_MODEL=
VIBES_GEMINI_MODEL=
VIBES_OPENROUTER_MODEL=
VIBES_COHERE_MODEL=
VIBES_COUNCIL_REVIEW_FILE=data/vibes-council-review.json
# Optional isolated code runtime. Leave blank to deny execution safely; the provider never runs code on the host.
VIBES_AGENT_SANDBOX_IMAGE=
VIBES_AGENT_SANDBOX_RUNTIME=docker


# Phase 6 source connectors — leave disabled unless you have reviewed the providers' current terms.
# Runs are manual only. Every result enters the pending review queue; none is auto-approved.
VIBES_SOURCE_CONNECTORS_ENABLED=false
# Optional. Leave blank to disable that connector. Never place provider keys in Android or browser code.
VIBES_BRAVE_SEARCH_API_KEY=
VIBES_YOUTUBE_API_KEY=
# Reddit uses server-side OAuth client credentials; public discussion excerpts remain opinion, not facts.
VIBES_REDDIT_CLIENT_ID=
VIBES_REDDIT_CLIENT_SECRET=
VIBES_SOURCE_STORE_FILE=data/vibes-source-learning.json
# Hard caps per manual run. Requests count retries; bytes are measured from response streams.
VIBES_SOURCE_MAX_REQUESTS_PER_RUN=8
VIBES_SOURCE_MAX_BYTES_PER_RUN=524288
VIBES_SOURCE_MAX_CANDIDATES_PER_RUN=15
# Persistent research storage capacity is configurable for the target deployment.
VIBES_SOURCE_STORE_MAX_CANDIDATES=10000
VIBES_SOURCE_STORE_MAX_RUNS=1000
VIBES_SOURCE_STORE_MAX_BYTES=67108864

# Phase 7 curriculum, reviewed claims, and synthetic practice store
VIBES_CURRICULUM_STORE_FILE=data/vibes-curriculum.json
# Phase 8: isolated, consent-gated cross-app feedback/learning store
# Keep this file outside public web roots and back it up under your data-retention policy.
VIBES_LEARNING_STORE_FILE=data/vibes-learning.json

# Phase 13/14: provide a 32-byte key as 64 hex characters via a secret manager. Never commit real values.
VIBES_PERSONAL_MEMORY_KEY_HEX=
VIBES_PERSONAL_MEMORY_FILE=data/personal-memory.enc
VIBES_SECURITY_AUDIT_FILE=data/security-audit.jsonl

# Phase 17–18 quality policy / operations (safe defaults; tune after load tests).
VIBES_DATA_DIRECTORY=data
VIBES_OPS_SWITCH_FILE=data/vibes-ops-switches.json
VIBES_PROVIDER_ROUTING_ENABLED=true
VIBES_BACKGROUND_LEARNING_ENABLED=false
VIBES_PROVIDER_TIMEOUT_MS=12000
VIBES_MAX_CONCURRENT_PROVIDER_CALLS=4
VIBES_PROVIDER_MAX_RETRIES=0
VIBES_PROVIDER_RETRY_BACKOFF_MS=250
VIBES_CHAT_LIMIT_PER_API_KEY_PER_MINUTE=20
VIBES_CHAT_LIMIT_PER_APP_PER_MINUTE=120
VIBES_REQUEST_PROVIDER_CALL_BUDGET=1
VIBES_REQUEST_NETWORK_CALL_BUDGET=4
VIBES_REQUEST_ELAPSED_BUDGET_MS=30000
VIBES_REQUEST_TOKEN_BUDGET=4096
VIBES_CIRCUIT_FAILURE_THRESHOLD=5
VIBES_CIRCUIT_OPEN_MS=30000
# Optional pricing from your current contract. Dashboard marks derived costs as estimates.
VIBES_UPSTREAM_INPUT_COST_PER_1K_USD=
VIBES_UPSTREAM_OUTPUT_COST_PER_1K_USD=
# Research service sample config may set independent per-run byte, request, and elapsed budgets.

# Per-account VYRON X installation registry and opaque client-encrypted private vault.
VIBES_USER_APP_REGISTRY_FILE=data/vibes-user-apps.json
VIBES_ENCRYPTED_VAULT_FILE=data/vibes-encrypted-vault.json

# Operations / observability / backups (mount a durable disk at /var/data)
VIBES_DATA_DIRECTORY=/var/data
VIBES_BACKUP_DIRECTORY=/var/data/backups
VIBES_BACKUP_INTERVAL_HOURS=24
VIBES_BACKUP_RESTORE_TEST_INTERVAL_DAYS=7
VIBES_SECURITY_AUDIT_FILE=/var/data/security-audit.jsonl

# Phase 2 — account sign-in. Keep real values in the host's secret store, never in this file.
# Legacy account JSON import/fallback path. SQL document storage is used when VIBES_DATABASE_URL is configured.
VIBES_ACCOUNTS_FILE=data/vibes-accounts.json
# Phone sign-in via Twilio Verify (all three required to enable it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional server-side model-training worker. Leave disabled until an actual trusted worker exists.
VIBES_TRAINING_ENABLED=false
VIBES_TRAINING_WORKER_URL=
VIBES_TRAINING_WORKER_API_KEY=
VIBES_TRAINING_ARTIFACT_ALLOWED_HOSTS=artifacts.example.com
VIBES_TRAINING_JOBS_FILE=data/vibes-training-jobs.json
# Training stays fail-closed unless the worker independently attests to its sandbox policy.


# Legacy auth-state and JWT key paths. SQL auth-state storage is preferred when VIBES_DATABASE_URL is configured.
# All instances must share the same database and JWT signing key.
VIBES_AUTH_SECURITY_FILE=/var/data/vibes-auth-security.json
VIBES_JWT_SIGNING_KEY_FILE=/var/data/vibes-jwt-signing.key
# Optional explicit HS256 key (32+ UTF-8 bytes); when unset, the server creates a 32-byte file-backed key.
VIBES_JWT_SECRET=

# Transactional platform database. SQLite is suitable for one server process; use PostgreSQL for
# multiple instances sharing one database. Back up the DB before any migration rollback.
VIBES_DATABASE_URL=jdbc:sqlite:/var/data/vibes-quantum.db
VIBES_DATABASE_USER=
VIBES_DATABASE_PASSWORD=

# Google Play Developer API subscription verification. The service-account JSON must be stored
# as a secret in the host environment; never commit its contents. Map product IDs to tiers.
VIBES_PLAY_PACKAGE_NAME=
VIBES_PLAY_SERVICE_ACCOUNT_JSON=
VIBES_PLAY_PRODUCT_TIERS={"vibes_pro_lite_monthly":"PRO_LITE","vibes_pro_monthly":"PRO","vibes_pro_plus_monthly":"PRO_PLUS"}

# Default server-side daily account entitlements (overridable by tier).
VIBES_FREE_DAILY_CLOUD_CALLS=10
VIBES_FREE_DAILY_SPEND_USD=0.10
VIBES_PRO_LITE_DAILY_CLOUD_CALLS=100
VIBES_PRO_LITE_DAILY_SPEND_USD=1.00
VIBES_PRO_DAILY_CLOUD_CALLS=500
VIBES_PRO_DAILY_SPEND_USD=5.00
VIBES_PRO_PLUS_DAILY_CLOUD_CALLS=2000
VIBES_PRO_PLUS_DAILY_SPEND_USD=20.00
VIBES_LLM_CALL_RESERVE_USD=0.05

# Render deployment notes (never put secrets in the mobile app).
# Render generates: https://vibes-quantum-api.onrender.com when the service keeps this name.
# api.vibesquantum.tech should be a Cloudflare-proxied custom domain on the same Render service.
# DuckDNS and custom domains remain optional fallbacks; repoint them to this same backend before use.
VIBES_RENDER_PUBLIC_URL=https://vibes-quantum-api.onrender.com
VIBES_CLOUDFLARE_PUBLIC_URL=https://api.vibesquantum.tech
VIBES_FALLBACK_PUBLIC_URLS=https://vibesquantum.duckdns.org,https://vibesquantum.tech,https://vibesquantum.com,https://api.vibesquantum.com

# Public API identity and exact allowed browser Origins (comma-separated, scheme + host only).
VIBES_PUBLIC_BASE_URL=https://vibes-quantum-api.onrender.com
VIBES_PUBLIC_ORIGINS=https://vibes-quantum-api.onrender.com,https://api.vibesquantum.tech,https://vibesquantum.duckdns.org,https://vibesquantum.tech,https://vibesquantum.com,https://api.vibesquantum.com
